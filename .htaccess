# Serve the branded 404 page instead of the host default
ErrorDocument 404 /404.html

RewriteEngine On

# ------------------------------------------------------------
# Force HTTPS
# Split from the www rule and guarded with X-Forwarded-Proto. The site sits
# behind the Sucuri firewall, which terminates SSL. If it ever forwards to the
# origin over plain http, a bare "%{HTTPS} !=on" test would redirect forever.
# Sucuri also does this redirect itself (Protocol Redirection: HTTPS only
# site), so this block is a backstop.
# ------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://hobbycon.com%{REQUEST_URI} [L,R=301]

# ------------------------------------------------------------
# Force non-www
# Example: https://www.hobbycon.com/contact -> https://hobbycon.com/contact
# ------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://hobbycon.com%{REQUEST_URI} [L,R=301]

# ------------------------------------------------------------
# Homepage redirects
# True homepage: /
# ------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^index/?$ / [R=301,L]
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^homepage/?$ / [R=301,L]
RewriteRule ^main/?$ / [R=301,L]

# ------------------------------------------------------------
# Redirect .html URLs to clean URLs
# Example: /retreats.html -> /retreats
# Example: /tickets.html -> /tickets
# ------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# ------------------------------------------------------------
# Retreats page alternates
# Official page: /retreats
# ------------------------------------------------------------
RewriteRule ^retreat/?$ /retreats [R=301,L]
RewriteRule ^retreat2026/?$ /retreats [R=301,L]
RewriteRule ^retreats2026/?$ /retreats [R=301,L]
RewriteRule ^hobbycon-retreat/?$ /retreats [R=301,L]
RewriteRule ^hobbycon-retreats/?$ /retreats [R=301,L]
RewriteRule ^mahjong/?$ /retreats [R=301,L]
RewriteRule ^mahjong-retreat/?$ /retreats [R=301,L]
RewriteRule ^mahjong-retreats/?$ /retreats [R=301,L]
RewriteRule ^yoga-retreat/?$ /retreats [R=301,L]
RewriteRule ^womens-retreat/?$ /retreats [R=301,L]
RewriteRule ^women-retreat/?$ /retreats [R=301,L]

