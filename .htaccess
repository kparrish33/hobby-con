# Serve the branded 404 page instead of the host default
ErrorDocument 404 /404.html

RewriteEngine On

# allow existing files/folders through
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# /highlight /highlights /new /press -> /news
RewriteRule ^(highlights?|new|press)/?$ /news [NC,R=301,L]

# /contact -> /contact.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

RewriteEngine On

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://hobbycon.com%{REQUEST_URI} [L,R=301]
