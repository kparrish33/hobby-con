# ------------------------------------------------------------
# Common typo redirects
# ------------------------------------------------------------
# Retreats typos
RewriteRule ^retrets/?$ /retreats [R=301,L]
RewriteRule ^reatreats/?$ /retreats [R=301,L]
RewriteRule ^retrats/?$ /retreats [R=301,L]
RewriteRule ^retreets/?$ /retreats [R=301,L]
RewriteRule ^retreatts/?$ /retreats [R=301,L]

# Tickets typos
RewriteRule ^tickts/?$ /tickets [R=301,L]
RewriteRule ^ticets/?$ /tickets [R=301,L]
RewriteRule ^tickes/?$ /tickets [R=301,L]
RewriteRule ^tix/?$ /tickets [R=301,L]

# Community typos
RewriteRule ^commmunity/?$ /community [R=301,L]
RewriteRule ^comunity/?$ /community [R=301,L]
RewriteRule ^communitiy/?$ /community [R=301,L]

# Contact typos
RewriteRule ^contct/?$ /contact [R=301,L]
RewriteRule ^conact/?$ /contact [R=301,L]
RewriteRule ^contacts/?$ /contact [R=301,L]

# Vendors typos
RewriteRule ^vender/?$ /vendors [R=301,L]
RewriteRule ^venders/?$ /vendors [R=301,L]
RewriteRule ^vendos/?$ /vendors [R=301,L]
RewriteRule ^vedors/?$ /vendors [R=301,L]

# Events typos
RewriteRule ^evnts/?$ /events [R=301,L]
RewriteRule ^eventz/?$ /events [R=301,L]

# ------------------------------------------------------------
# Allow existing files/folders through
# This keeps images, CSS, JS, PDFs, PHP files, etc. working.
# ------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ------------------------------------------------------------
# Pretty URLs
# Example: /retreats quietly loads /retreats.html
# Example: /tickets quietly loads /tickets.html
# ------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
